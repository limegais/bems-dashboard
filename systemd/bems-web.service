[Unit]
Description=BEMS Web Dashboard HTTP Server
After=network.target

[Service]
Type=simple
User=iotlab
WorkingDirectory=/home/iotlab/bems-dashboard
ExecStart=/usr/bin/python3 -m http.server 3001 --bind 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
