[Unit]
Description=BEMS Web Dashboard HTTP Server
After=network.target

[Service]
Type=simple
User=iotlab
WorkingDirectory=/home/iotlab/bems-dashboard
ExecStart=/home/iotlab/bems-dashboard/.venv/bin/python server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
